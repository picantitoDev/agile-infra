<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detalle de Movimiento</title>
  </head>
  <body>
    <h1>Detalle del Movimiento</h1>

    <h2>Información General</h2>
    <p>
      <strong>Fecha:</strong> <%= new
      Date(movimientoDetalle[0].fecha).toLocaleString() %>
    </p>
    <p><strong>Tipo:</strong> <%= movimientoDetalle[0].tipo %></p>
    <p><strong>Descripción:</strong> <%= movimientoDetalle[0].descripcion %></p>
    <p><strong>Usuario:</strong> <%= movimientoDetalle[0].usuario %></p>

    <% if (movimientoDetalle[0].tipo === 'Venta') { %>
    <h2>Datos de Venta</h2>
    <p>
      <strong>Nombre Cliente:</strong> <%= movimientoDetalle[0].nombre_cliente
      %>
    </p>
    <p>
      <strong>Razón Social:</strong> <%= movimientoDetalle[0].razon_social %>
    </p>
    <p><strong>DNI:</strong> <%= movimientoDetalle[0].dni_cliente %></p>
    <p><strong>RUC:</strong> <%= movimientoDetalle[0].ruc_cliente %></p>
    <p><strong>Correo:</strong> <%= movimientoDetalle[0].correo_cliente %></p>
    <p>
      <strong>Dirección:</strong> <%= movimientoDetalle[0].direccion_cliente %>
    </p>
    <p>
      <strong>Comprobante:</strong> <%= movimientoDetalle[0].tipo_comprobante %>
    </p>
    <p><strong>Total Venta:</strong> <%= movimientoDetalle[0].total_venta %></p>
    <% } else if (movimientoDetalle[0].tipo === 'Compra') { %>
    <h2>Datos de Compra</h2>
    <p><strong>Proveedor:</strong> <%= movimientoDetalle[0].id_proveedor %></p>
    <p>
      <strong>Total Compra:</strong> <%= movimientoDetalle[0].total_compra %>
    </p>
    <% } else if (movimientoDetalle[0].tipo === 'Ajuste') { %>
    <h2>Datos de Ajuste</h2>
    <p>
      <strong>Tipo de Ajuste:</strong> <%= movimientoDetalle[0].tipo_ajuste %>
    </p>
    <p><strong>Motivo:</strong> <%= movimientoDetalle[0].motivo %></p>
    <% } %>

    <h2>Productos Afectados</h2>
    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Cantidad</th>
          <th>Precio Unitario</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% movimientoDetalle.forEach((item) => { %>
        <tr>
          <td><%= item.producto %></td>
          <td><%= item.cantidad %></td>
          <td><%= item.precio_unitario %></td>
          <td><%= item.subtotal %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </body>
</html>
