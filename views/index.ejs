<head>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<% if (!user) { %>
<div class="login-background">
  <div class="login-container">
    <div class="login-form-section">
      <div class="login-header">
        <i class="fas fa-user-shield login-icon"></i>
        <h1 class="login-title">Iniciar Sesión</h1>
        <p class="login-subtitle">Ingresa tus credenciales para acceder</p>
      </div>
      <form action="/log-in" method="POST" class="login-form">
        <div class="input-group">
          <label for="username">Usuario</label>
          <input id="username" name="username" placeholder="Ingresa tu usuario o email" type="text" required />
        </div>
        <div class="input-group">
          <label for="password">Contraseña</label>
          <input id="password" name="password" placeholder="Ingresa tu contraseña" type="password" required />
        </div>
        <% if (error && error !== '') { %>
        <div class="flash-error"><%= error %></div>
        <% } %>
        <button type="submit" class="login-button"><i class="fas fa-sign-in-alt"></i> Ingresar</button>
      </form>

      <!-- Enlace para restablecer contraseña -->
      <div class="forgot-password-link" style="margin-top: 10px; text-align: center;">
        <a href="/recovery/forgot-password">¿Olvidaste tu contraseña?</a>
      </div>
    </div>
    <div class="login-image-section">
      <div class="login-image-content">
        <h2>Sistema de Gestión de Inventario</h2>
        <p>Administra tus productos y existencias de manera eficiente con nuestra plataforma intuitiva.</p>
      </div>
    </div>
  </div>
</div>
<% } else { %>
  <h1>Bienvenido, <%= user.username %> 👋</h1>

<div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 20px;">
  <!-- Gráfico de Barras -->
  <div style="background: #fff; padding: 20px; border-radius: 10px;">
    <h2>Ventas por mes</h2>
    <canvas id="barChart"></canvas>
  </div>

  <!-- Gráfico de Torta -->
  <div style="background: #fff; padding: 20px; border-radius: 10px;">
    <h2>Distribución de Categorías</h2>
    <canvas id="pieChart"></canvas>
  </div>

  <!-- Leaderboard -->
  <div style="background: #fff; padding: 20px; border-radius: 10px;">
    <h2>Top Vendedores</h2>
    <ol>
      <li>Ana Pérez - 120 ventas</li>
      <li>Carlos López - 110 ventas</li>
      <li>Lucía Torres - 98 ventas</li>
    </ol>
  </div>

  <!-- Lista de Órdenes -->
  <div style="background: #fff; padding: 20px; border-radius: 10px;">
    <h2>Últimas órdenes</h2>
    <ul>
      <li>Orden #00123 - Cliente: Juan - $320</li>
      <li>Orden #00124 - Cliente: Rosa - $145</li>
      <li>Orden #00125 - Cliente: Miguel - $250</li>
    </ul>
  </div>
</div>

<script>
  // Bar Chart
  const barCtx = document.getElementById('barChart');
  new Chart(barCtx, {
    type: 'bar',
    data: {
      labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
      datasets: [{
        label: 'Ventas ($)',
        data: [1200, 1900, 3000, 2500, 3200, 2900],
        backgroundColor: '#4e73df'
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: { display: false }
      }
    }
  });

  // Pie Chart
  const pieCtx = document.getElementById('pieChart');
  new Chart(pieCtx, {
    type: 'pie',
    data: {
      labels: ['Electrónica', 'Ropa', 'Hogar', 'Libros'],
      datasets: [{
        data: [40, 25, 20, 15],
        backgroundColor: ['#36b9cc', '#1cc88a', '#f6c23e', '#e74a3b']
      }]
    },
    options: {
      responsive: true
    }
  });
</script>

  <% } %>