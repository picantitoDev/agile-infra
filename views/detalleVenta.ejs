<!DOCTYPE html>
<html>
  <head>
    <title>Detalle de Venta Nº <%= venta.id_venta %></title>
    <style>
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1rem;
      }
      th,
      td {
        border: 1px solid #ccc;
        padding: 8px;
        text-align: left;
      }
      th {
        background-color: #f5f5f5;
      }
    </style>
  </head>
  <body>
    <h1>Detalle de Venta Nº <%= venta.id_venta %></h1>

    <h2>Información del Cliente</h2>
    <ul>
      <li><strong>Nombre:</strong> <%= venta.nombre_cliente || '---' %></li>
      <li><strong>Correo:</strong> <%= venta.correo_cliente %></li>
      <li><strong>DNI:</strong> <%= venta.dni_cliente || '---' %></li>
      <li><strong>RUC:</strong> <%= venta.ruc_cliente || '---' %></li>
      <li><strong>Razón Social:</strong> <%= venta.razon_social || '---' %></li>
    </ul>

    <h2>Comprobante</h2>
    <ul>
      <li><strong>Tipo:</strong> <%= venta.tipo_comprobante %></li>
      <li><strong>Fecha:</strong> <%= venta.fecha %></li>
      <li><strong>Descripción:</strong> <%= venta.descripcion || '---' %></li>
    </ul>

    <h2>Productos Vendidos</h2>
    <table>
      <thead>
        <tr>
          <th>SKU</th>
          <th>Nombre</th>
          <th>Cantidad</th>
          <th>Unidad</th>
          <th>Precio Unitario</th>
          <th>Subtotal</th>
          <th>Stock Actual</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% detalle.forEach(d => { %>
        <tr>
          <td><%= d.sku %></td>
          <td><%= d.nombre %></td>
          <td><%= d.cantidad %></td>
          <td><%= d.unidad_medida %></td>
          <td>S/ <%= d.precio_unitario %></td>
          <td>S/ <%= d.subtotal %></td>
          <td><%= d.stock %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <h3>Total de la Venta: S/ <%= venta.total %></h3>

    <form
      action="/ventas/<%= venta.id_venta %>/pdf"
      method="get"
      target="_blank"
    >
      <button type="submit">🧾 Descargar PDF</button>
    </form>
    <a href="/ventas">⬅️ Volver a Ventas</a>
  </body>
</html>
