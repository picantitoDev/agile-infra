<!DOCTYPE html>
<html lang="en">
  <head>
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <title><%= locals.user ? 'Menú Principal' : 'Iniciar Sesión' %></title>
    <link rel="stylesheet" href="styles.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>
  <body>
    <% if (locals.user) { %>
    <a
      href="/log-out"
      style="
        position: fixed;
        top: 1rem;
        right: 1rem;
        background-color: #4c6ef5; /* Indigo */
        color: white;
        padding: 0.6rem;
        border-radius: 50%;
        text-decoration: none;
        font-size: 1.5rem;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.3s ease;
      "
      title="Cerrar Sesión"
      onmouseover="this.style.backgroundColor='#4051a1'"
      onmouseout="this.style.backgroundColor='#4c6ef5'"
    >
      <i class="fas fa-right-from-bracket"></i>
    </a>
    <% } %> <% if (locals.user) {%>
    <div
      class="menu-container <%= user.rol !== 'Admin' ? 'logged-in-usuario' : '' %>"
    >
      <a href="/categorias" class="menu-card">
        <i class="fas fa-tags"></i>
        <span>Categorías</span>
        <p>Gestiona las categorías</p>
      </a>
      <a href="/productos" class="menu-card">
        <i class="fas fa-box"></i>
        <span>Productos</span>
        <p>Administra tu inventario</p>
      </a>
      <a href="/proveedores" class="menu-card">
        <i class="fas fa-truck"></i>
        <span>Proveedores</span>
        <p>Controla tus relaciones</p>
      </a>
      <a href="/movimientos" class="menu-card">
        <i class="fas fa-arrows-rotate"></i>
        <span>Movimientos</span>
        <p>Monitorea tus transacciones</p>
      </a>
      <% if (user.rol === 'Admin') { %>
      <a href="/usuarios" class="menu-card">
        <i class="fas fa-users"></i>
        <span>Usuarios</span>
        <p>Administra accesos</p>
      </a>
      <% } %>
    </div>

    <% } else { %>
    <div class="login-background">
      <div class="login-container">
        <div class="login-header">
          <i class="fas fa-user-shield login-icon"></i>
          <h1 class="login-title">Iniciar Sesión</h1>
          <p class="login-subtitle">Ingresa tus credenciales para acceder</p>
        </div>

        <form action="/log-in" method="POST" class="login-form">
          <div class="input-group">
            <label for="username"> <i class="fas fa-user"></i> Usuario </label>
            <input
              id="username"
              name="username"
              placeholder="Ingresa tu usuario o email"
              type="text"
              required
            />
          </div>

          <div class="input-group">
            <label for="password">
              <i class="fas fa-lock"></i> Contraseña
            </label>
            <input
              id="password"
              name="password"
              placeholder="Ingresa tu contraseña"
              type="password"
              required
            />
          </div>
          <button type="submit" class="login-button">
            <i class="fas fa-sign-in-alt"></i> Ingresar
          </button>
        </form>
      </div>
    </div>
    <%}%>
  </body>
</html>
