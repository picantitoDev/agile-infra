<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <title>Detalle de Movimiento</title>
    <link rel="stylesheet" href="/detalleMovimiento.css" />
  </head>
  <body>
    <div class="container">
      <a href="/movimientos" class="atras-btn">← Atrás</a>
      <h1 class="title">Detalle del Movimiento</h1>

      <section class="section">
        <h2 class="section-title">Información General</h2>
        <div class="info-container">
          <% const fecha = new Date(movimientoDetalle[0].fecha); const
          fechaFormateada = fecha.toLocaleDateString("es-PE", { year: "numeric",
          month: "long", day: "numeric", hour: "2-digit", minute: "2-digit", });
          %>
          <p><strong>Fecha:</strong> <%= fechaFormateada %></p>
          <p>
            <strong>Tipo:</strong> <%= movimientoDetalle[0].tipo === 'Compra' ?
            'Entrada' : movimientoDetalle[0].tipo %>
          </p>
          <p>
            <strong>Descripción:</strong>
            <%= (movimientoDetalle[0].tipo === 'Venta' &&
            !movimientoDetalle[0].descripcion) ? 'Venta realizada con éxito' :
            movimientoDetalle[0].descripcion %>
          </p>
          <p><strong>Usuario:</strong> <%= movimientoDetalle[0].usuario %></p>
        </div>
      </section>

      <% if (movimientoDetalle[0].tipo === 'Venta') { %>
      <section class="section">
        <h2 class="section-title">Datos de Venta</h2>
        <div class="info-container">
          <% if (movimientoDetalle[0].tipo_comprobante === "factura") { %>
          <p>
            <strong>Razón Social:</strong> <%= movimientoDetalle[0].razon_social
            %>
          </p>
          <p><strong>RUC:</strong> <%= movimientoDetalle[0].ruc_cliente %></p>
          <% } else if (movimientoDetalle[0].tipo_comprobante === "boleta") { %>
          <p>
            <strong>Nombre Cliente:</strong> <%=
            movimientoDetalle[0].nombre_cliente %>
          </p>
          <p><strong>DNI:</strong> <%= movimientoDetalle[0].dni_cliente %></p>
          <% } %>

          <p>
            <strong>Correo:</strong> <%= movimientoDetalle[0].correo_cliente %>
          </p>
          <p>
            <strong>Dirección:</strong> <%=
            movimientoDetalle[0].direccion_cliente %>
          </p>
          <p>
            <strong>Comprobante:</strong> <%=
            movimientoDetalle[0].tipo_comprobante %>
          </p>
          <p>
            <strong>Total Venta:</strong> <%= movimientoDetalle[0].total_venta
            %>
          </p>
        </div>
        <section class="section">
          <h2 class="section-title">Productos Afectados</h2>
          <table class="table">
            <thead>
              <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio Unitario</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% movimientoDetalle.forEach((item) => { %>
              <tr>
                <td><%= item.producto %></td>
                <td><%= item.cantidad %></td>
                <td><%= item.precio_unitario %></td>
                <td><%= item.subtotal %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </section>
        <a
          href="/movimientos/detalle/<%= movimientoDetalle[0].id_movimiento %>/comprobante"
          class="btn"
        >
          Descargar Comprobante
        </a>
      </section>
      <% } else if (movimientoDetalle[0].tipo === 'Compra') { %>
      <section class="section">
        <h2 class="section-title">Datos de Entrada</h2>
        <div class="info-container">
          <p>
            <strong>Proveedor:</strong>
            <%= proveedores.find(p => p.id_proveedor ===
            movimientoDetalle[0].id_proveedor)?.razon_social || 'Desconocido' %>
          </p>
          <p>
            <strong>Total Compra:</strong> <%= movimientoDetalle[0].total_compra
            %>
          </p>
        </div>
      </section>
      <section class="section">
        <h2 class="section-title">Productos Afectados</h2>
        <table class="table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Cantidad</th>
              <th>Precio Unitario</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% movimientoDetalle.forEach((item) => { %>
            <tr>
              <td><%= item.producto %></td>
              <td><%= item.cantidad %></td>
              <td><%= item.precio_unitario %></td>
              <td><%= item.subtotal %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
      <% } else if (movimientoDetalle[0].tipo === 'Merma') { %>
      <section class="section">
        <h2 class="section-title">Datos de Merma</h2>
        <div class="info-container">
          <p>
            <strong>Motivo de Merma:</strong> <%= movimientoDetalle[0].motivo %>
          </p>
          <p>
            <strong>Cantidad Merma:</strong> <%= movimientoDetalle[0].cantidad
            %>
          </p>
        </div>
      </section>
      <section class="section">
        <h2 class="section-title">Productos Afectados</h2>
        <table class="table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Cantidad</th>
              <th>Precio Unitario</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% movimientoDetalle.forEach((item) => { %>
            <tr>
              <td><%= item.producto %></td>
              <td><%= item.cantidad %></td>
              <td><%= item.precio_unitario %></td>
              <td><%= item.subtotal %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
      <% } else if (movimientoDetalle[0].tipo === 'Sobrante') { %>
      <section class="section">
        <h2 class="section-title">Datos de Sobrante</h2>
        <div class="info-container">
          <p>
            <strong>Motivo de Sobrante:</strong> <%= movimientoDetalle[0].motivo
            %>
          </p>
          <p>
            <strong>Cantidad Sobrante:</strong> <%=
            movimientoDetalle[0].cantidad %>
          </p>
        </div>
      </section>
      <section class="section">
        <h2 class="section-title">Productos Afectados</h2>
        <table class="table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Cantidad</th>
              <th>Precio Unitario</th>
              <th>Subtotal</th>
            </tr>
          </thead>
          <tbody>
            <% movimientoDetalle.forEach((item) => { %>
            <tr>
              <td><%= item.producto %></td>
              <td><%= item.cantidad %></td>
              <td><%= item.precio_unitario %></td>
              <td><%= item.subtotal %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
      <% } %>
    </div>
  </body>
</html>
