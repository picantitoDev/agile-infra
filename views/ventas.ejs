<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <title>Listado de Ventas</title>
    <link rel="stylesheet" href="/listarVentas.css" />
  </head>
  <body>
    <div class="container">
      <h1>Listado de Ventas</h1>
      <form action="/ventas/nueva-venta" method="get">
        <button type="submit" class="btn-nueva-venta">Nueva Venta</button>
      </form>
      <% if (ventas.length > 0) { %>
      <table class="ventas-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Total</th>
            <th>Cliente</th>
            <th>Correo</th>
            <th>Detalle</th>
          </tr>
        </thead>
        <tbody>
          <% ventas.forEach(venta => { %>
          <tr>
            <td><%= venta.id_venta %></td>
            <td><%= new Date(venta.fecha).toLocaleDateString() %></td>
            <td>S/. <%= venta.total %></td>
            <td>
              <%= venta.tipo_comprobante === 'boleta' ? (venta.nombre_cliente ||
              'Sin nombre') : (venta.razon_social || 'Sin razón social') %>
            </td>
            <td><%= venta.correo_cliente %></td>
            <td>
              <form action="/ventas/<%= venta.id_venta %>" method="get">
                <button type="submit" class="btn-detalle">Ver detalle</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <p>No hay ventas registradas aún.</p>
      <% } %>
    </div>
  </body>
</html>
