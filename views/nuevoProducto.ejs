<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Crear Producto</title>
    <link rel="stylesheet" href="/crearProducto.css" />
  </head>
  <body>
    <div class="container">
      <section class="form-section">
        <a href="/productos" class="back-btn">
          <span class="back-arrow">←</span> Atrás
        </a>
        <h2 style="text-align: center">Registrar Nuevo Producto</h2>
        <form action="/productos/crear-producto" method="POST">
          <div>
            <label for="nombre">Nombre del Producto:</label>
            <input type="text" id="nombre" name="nombre" required />
          </div>
          <div>
            <label for="cantidad_minima">Cantidad Mínima:</label>
            <input
              type="number"
              id="cantidad_minima"
              name="cantidad_minima"
              required
            />
          </div>
          <div>
            <label for="stock">Stock:</label>
            <input type="number" id="stock" name="stock" required />
          </div>
          <div>
            <label for="precio_unitario">Precio Unitario:</label>
            <input
              type="number"
              step="0.01"
              id="precio_unitario"
              name="precio_unitario"
              required
            />
          </div>
          <div>
            <label for="categoria">Categoría:</label>
            <select id="categoria" name="id_categoria" required>
              <% categorias.forEach((categoria) => { %>
              <option value="<%= categoria.id_categoria %>">
                <%= categoria.nombre %>
              </option>
              <% }) %>
            </select>
          </div>
          <div>
            <label for="proveedor">Proveedor:</label>
            <select id="proveedor" name="id_proveedor" required>
              <% proveedores.forEach((proveedor) => { %>
              <option value="<%= proveedor.id_proveedor %>">
                <%= proveedor.razon_social %>
              </option>
              <% }) %>
            </select>
          </div>
          <button type="submit">Registrar Producto</button>
        </form>
      </section>
    </div>
  </body>
</html>
